# Copy to clerk-keys.local.env and fill with Production keys from Clerk Dashboard.
# NEVER commit clerk-keys.local.env
#
# JWKS: Configure → API Keys → Advanced → JWKS Endpoint (per application)
# Same instance → same JWKS URL for all four is OK.

# --- Customer (website + customer portal + mobile-customer) ---
CLERK_CUSTOMER_PUBLISHABLE_KEY=pk_live_
CLERK_CUSTOMER_SECRET_KEY=sk_live_
CLERK_CUSTOMER_JWKS_URL=https://relaxing-warthog-11.clerk.accounts.dev/.well-known/jwks.json

# --- Merchant ---
CLERK_MERCHANT_PUBLISHABLE_KEY=pk_live_
CLERK_MERCHANT_SECRET_KEY=sk_live_
CLERK_MERCHANT_JWKS_URL=https://relaxing-warthog-11.clerk.accounts.dev/.well-known/jwks.json

# --- Admin ---
CLERK_ADMIN_PUBLISHABLE_KEY=pk_live_
CLERK_ADMIN_SECRET_KEY=sk_live_
CLERK_ADMIN_JWKS_URL=https://relaxing-warthog-11.clerk.accounts.dev/.well-known/jwks.json

# --- Driver (driver portal + mobile-driver) ---
CLERK_DRIVER_PUBLISHABLE_KEY=pk_live_
CLERK_DRIVER_SECRET_KEY=sk_live_
CLERK_DRIVER_JWKS_URL=https://relaxing-warthog-11.clerk.accounts.dev/.well-known/jwks.json
