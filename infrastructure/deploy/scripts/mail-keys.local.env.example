# ZeptoMail Send Mail Token (Canada DC). Gitignored copy: mail-keys.local.env
# Upload: bash infrastructure/deploy/scripts/upload-mail-to-doppler.sh
#
# This is NOT Zoho Mail inbox SMTP (smtp.zohocloud.ca) and NOT local Mailpit.
# Production sends via HTTPS https://api.zeptomail.ca/v1.1/email
# (DigitalOcean blocks outbound SMTP). The upload script forces host, user,
# and MAIL_TRANSPORT=https — only the token and From aliases come from this file.
#
# Agent → Mail Agents → SMTP/API → Send Mail Token.
# From addresses must be verified aliases on that agent.

MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@porterchain.com
MAIL_FROM_ADDRESS2=sales@porterchain.com
MAIL_FROM_ADDRESS3=ravi@porterchain.com
MAIL_FROM_NAME=Porterchain
PORTERCHAIN_OPS_EMAILS=ops@porterchain.com
