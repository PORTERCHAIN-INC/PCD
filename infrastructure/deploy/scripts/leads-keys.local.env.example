# Copy to leads-keys.local.env (gitignored) and fill vendor tokens, then:
#   LEADS_ENV=infrastructure/deploy/scripts/leads-keys.local.env \
#     bash infrastructure/deploy/scripts/upload-leads-to-doppler.sh
#
# Leave blank to skip. GOOGLE_LEAD_WEBHOOK_SECRET / SOCIAL_LEAD_WEBHOOK_SECRET
# are auto-generated when missing in Doppler.

# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_CAPI_ACCESS_TOKEN=
# META_PIXEL_ID=
# LINKEDIN_CAPI_TOKEN=
# LINKEDIN_CONVERSION_URN=urn:lla:llaPartnerConversion:
# LEAD_TERRITORY_MAP_JSON={"ON":"","DEFAULT":""}
# LEAD_SLA_MINUTES_JSON={"whatsapp":15,"phone_call":30,"default":60}
# REFERRAL_CREDIT_CENTS=25000
# PUBLIC_INGEST_API_KEY=
