# /opt/porterchain/backup.env  (chmod 600, owner root) — used by porterchain-postgres-backup.service
# No secrets in git: fill on the droplet only.

BACKUP_SOURCE=compose
POSTGRES_SERVICE=postgres
POSTGRES_USER=porterchain
BACKUP_DATABASES="porterchain spicedb"

# Encryption — pick ONE. age is preferred: only the PUBLIC key lives on the droplet;
# keep the private key (age-keygen output) offline in the password manager + a second location.
AGE_RECIPIENTS_FILE=/opt/porterchain/backup-age-recipients.txt
# GPG_RECIPIENT=backups@porterchain.com
# BACKUP_PASSPHRASE_FILE=/opt/porterchain/backup-passphrase   # gpg --symmetric AES256

# Off-site target — a bucket in a DIFFERENT provider/region than the droplet is best
# (e.g. Cloudflare R2 or Backblaze B2; DO Spaces in another region at minimum).
# Enable bucket versioning / object lock if available so a compromised droplet cannot erase history.
OFFSITE_TARGET=s3://porterchain-db-backups/postgres
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=...          # write+list-only key scoped to this bucket (no delete if object lock does retention)
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=auto
# or: OFFSITE_TARGET=rclone:offsite:porterchain-db-backups/postgres  (RCLONE_CONFIG=/opt/porterchain/rclone.conf)

LOCAL_RETENTION_DAYS=3
OFFSITE_DAILY_DAYS=14
OFFSITE_MONTHLY_MONTHS=12
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>   # alerts if a night is missed
