# =============================================================================
# ADMIN PLATFORM — Next.js internal ops (port 3002)
# Copy to: apps/admin/.env.local
# =============================================================================

# --- REQUIRED — Clerk auth (porterchain-admin Clerk application) ---------------

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production: use CLERK_ADMIN_PUBLISHABLE_KEY / CLERK_ADMIN_SECRET_KEY values

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Local dev — use Bearer dev for Porterchain API (must match API CLERK_DEV_BYPASS=true)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_CLERK_DEV_BYPASS=true

# --- Admin security (Clerk + Porterchain staff allowlist) --------------------
# 1. Disable public sign-up in Clerk Dashboard → User & Authentication → Restrictions
# 2. Provision each staff email in admin_users (Settings → Staff in admin, or API seed)
# 3. Portal calls GET /v1/auth/admin/access — returns 403 if not provisioned staff
# Clerk login alone does NOT grant admin access.

# --- Google Maps (live map, order embeds — browser/restricted key) ---
# Loaded automatically from env/.env (GOOGLE_MAPS_BROWSER_API_KEY) when you run admin locally.
# Override here if needed:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional — other Porterchain apps (defaults to localhost in dev) ---
# NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
# NEXT_PUBLIC_MERCHANT_PORTAL_URL=http://localhost:3001
# NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3004
# NEXT_PUBLIC_DRIVER_PORTAL_URL=http://localhost:3003
# NEXT_PUBLIC_FLEETBASE_CONSOLE_URL=http://localhost:4200
# NEXT_PUBLIC_FLEETBASE_API_URL=http://localhost:8000
# NEXT_PUBLIC_VALHALLA_URL=http://localhost:8002/status
# NEXT_PUBLIC_MAILHOG_URL=http://localhost:8025
