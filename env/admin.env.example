# =============================================================================
# ADMIN PLATFORM — Next.js internal ops (port 3002)
# Copy to: apps/admin/.env.local
# =============================================================================

# --- Legacy Clerk keys (optional leftovers; admin auth is Staff IdP) ------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Local — Staff IdP. Set NEXT_PUBLIC_CLERK_DEV_BYPASS=false to force magic-link UI.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_CLERK_DEV_BYPASS=true

# --- Admin security (Staff IdP) ----------------------------------------------
# Clerk is retired for admin. Provision via:
#   pnpm auth:bootstrap
#   pnpm auth:provision-admin you@porterchain.com -- --role dispatcher
# Sign-in: /sign-in · Activate: /activate-staff?token=… · Mailpit: :8025

# --- Google Maps (live map, order embeds — browser/restricted key) ---
# Loaded automatically from env/.env (GOOGLE_MAPS_BROWSER_API_KEY) when you run admin locally.
# Override here if needed:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional — other Porterchain apps (defaults to localhost in dev) ---
# NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
# NEXT_PUBLIC_MERCHANT_PORTAL_URL=http://localhost:3001
# NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3004
# NEXT_PUBLIC_DRIVER_PORTAL_URL=http://localhost:3003
# NEXT_PUBLIC_VALHALLA_URL=http://localhost:8002/status
# NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025
