# =============================================================================
# ADMIN PLATFORM — Next.js internal ops (port 3002)
# Copy to: apps/admin/.env.local
# =============================================================================

# Keycloak OIDC (L36) — realm porterchain, public client pc-admin (PKCE). Admin tiers must use an
# authenticator app (TOTP). AUTH_SESSION_SECRET (32+ random chars) comes from SOPS.
KEYCLOAK_URL=http://localhost:8180
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=porterchain
KEYCLOAK_CLIENT_ID=pc-admin
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=pc-admin
AUTH_SESSION_SECRET=
AUTH_SIGN_IN_PATH=/sign-in
# Production: https://auth.porterchain.com

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Local only — skip sign-in and use API Bearer `dev`; API must run with AUTH_DEV_BYPASS=true.
NEXT_PUBLIC_APP_ENV=local
# NEXT_PUBLIC_AUTH_DEV_BYPASS=true

# --- Admin security --------------------------------------------------------------
# Staff are Keycloak users. Enrol from Settings → Users (the API creates the Keycloak user via the
# pc-api-admin service account and emails the setup link). Step-up = sign-in within 15 minutes.

# --- Google Maps (live map, order embeds — browser/restricted key) ---
# Override here if needed:

# --- Optional — other Porterchain apps (defaults to localhost in dev) ---
# NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
# NEXT_PUBLIC_MERCHANT_PORTAL_URL=http://localhost:3001
# NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3004
# NEXT_PUBLIC_DRIVER_PORTAL_URL=http://localhost:3003
# NEXT_PUBLIC_VALHALLA_URL=http://localhost:8002/status
# NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025
