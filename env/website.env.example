# =============================================================================
# WEBSITE — Next.js public site (port 3000)
# Copy to: website/.env.local
# =============================================================================

# --- REQUIRED (active in code today) -----------------------------------------

# Google Maps / Places API (New) — HTTP referrer restricted in GCP
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- REQUIRED (API + Platform Clerk for CTAs) --------------------------------

# Production API URL (guest track): https://api.porterchain.com
NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001

# Clerk — Platform application (marketing login/sign-up → customer portal book)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production: use CLERK_CUSTOMER_PUBLISHABLE_KEY / CLERK_CUSTOMER_SECRET_KEY values
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login

# Public contact email (footer, forms, legal pages)
NEXT_PUBLIC_CONTACT_EMAIL=driver@porterchain.com

# --- OPTIONAL — site & SEO ---------------------------------------------------

# Canonical production URL (sitemap, canonical tags, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — porterchain web stream (public measurement ID)
# Stream name: porterchain | Stream URL: https://www.porterchain.com
# Stream ID: 15224607266 (GA admin only — not used in app code)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-VWMZWJ4W4M

# Google Search Console site verification meta tag content value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

# Google Business Profile — public Maps / g.page URL (after claiming GBP)
# Share link from business.google.com → Add to website
# NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=https://maps.app.goo.gl/...
# Optional direct review link from GBP dashboard → Get more reviews
# NEXT_PUBLIC_GOOGLE_BUSINESS_REVIEW_URL=https://search.google.com/local/writereview?placeid=...

# Public phone (schema.org + GBP NAP consistency)
NEXT_PUBLIC_CONTACT_PHONE=+16476197951

# Portal URLs (unified login redirects by user type)
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_MERCHANT_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3004
NEXT_PUBLIC_DRIVER_PORTAL_URL=http://localhost:3003

# --- OPTIONAL — Zoho SalesIQ live chat ---------------------------------------

NEXT_PUBLIC_ZOHO_SALESIQ_ENABLED=false
# Deprecated — on-site Logistics line replaced Zoho SalesIQ chat
# NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=

# Website → API public ingest (server-side only; must match API PUBLIC_INGEST_API_KEY)
PUBLIC_INGEST_API_KEY=
# Shared with API WEBSITE_REVALIDATE_SECRET — on-demand blog revalidation
WEBSITE_REVALIDATE_SECRET=

# Optional CDN/origin for blog media (must match API BLOG_MEDIA_PUBLIC_BASE_URL).
# When set, markdown media + covers resolve here instead of the API origin.
# NEXT_PUBLIC_BLOG_MEDIA_CDN=https://media.porterchain.com
NEXT_PUBLIC_BLOG_MEDIA_CDN=

# --- OPTIONAL — social links (footer overrides; site has hardcoded defaults) ---

NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/porterchain
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/porterchain/
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61568324733884
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@porterchain
NEXT_PUBLIC_SOCIAL_WHATSAPP=https://wa.me/16476197951

# --- OPTIONAL — driver app store links (drive / download page) ---------------

NEXT_PUBLIC_DRIVER_APP_IOS_URL=
NEXT_PUBLIC_DRIVER_APP_ANDROID_URL=

# --- OPTIONAL — monitoring ---------------------------------------------------

# NEXT_PUBLIC_SENTRY_DSN=
