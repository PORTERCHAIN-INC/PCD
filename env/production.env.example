# =============================================================================
# PORTERCHAIN — production URLs (copy values into droplet /opt/porterchain/.env
# and GitHub Actions vars/secrets). DNS must point all hosts to the droplet.
# =============================================================================

# --- Public origins (HTTPS) ----------------------------------------------------

WEBSITE_URL=https://porterchain.com
ADMIN_PORTAL_URL=https://admin.porterchain.com
MERCHANT_PORTAL_URL=https://merchant.porterchain.com
DRIVER_PORTAL_URL=https://driver.porterchain.com
CUSTOMER_PORTAL_URL=https://customer.porterchain.com
PORTERCHAIN_API_URL=https://api.porterchain.com

# --- API (apps/api + docker-compose.prod.yml) ----------------------------------

APP_ENV=production
APP_DEBUG=false
CORS_ORIGINS=https://porterchain.com,https://www.porterchain.com,https://admin.porterchain.com,https://merchant.porterchain.com,https://driver.porterchain.com,https://customer.porterchain.com

RETAIL_CHECKOUT_SUCCESS_URL=https://porterchain.com/en/book/success
RETAIL_CHECKOUT_CANCEL_URL=https://porterchain.com/en/book/continue
CUSTOMER_CHECKOUT_SUCCESS_URL=https://customer.porterchain.com/book/success
CUSTOMER_CHECKOUT_CANCEL_URL=https://customer.porterchain.com/book
PORTERCHAIN_RETAIL_PAY_URL_BASE=https://porterchain.com/track
PORTERCHAIN_RETAIL_STRIPE_SUCCESS_URL=https://porterchain.com/track/{tracking_number}?paid=1
PORTERCHAIN_RETAIL_STRIPE_CANCEL_URL=https://porterchain.com/track/{tracking_number}?cancelled=1
PORTERCHAIN_STRIPE_SUCCESS_URL=https://merchant.porterchain.com/invoices?paid=1
PORTERCHAIN_STRIPE_CANCEL_URL=https://merchant.porterchain.com/invoices?cancelled=1
PORTERCHAIN_TRACKING_URL=https://porterchain.com/track/
DRIVER_PORTAL_BASE_URL=https://driver.porterchain.com


# --- Next.js build args (per portal image) -------------------------------------

# Website — same-origin API via Caddy /v1/* (omit NEXT_PUBLIC_PORTERCHAIN_API_URL)
# NEXT_PUBLIC_SITE_URL=https://porterchain.com
# NEXT_PUBLIC_MERCHANT_PORTAL_URL=https://merchant.porterchain.com
# NEXT_PUBLIC_ADMIN_PORTAL_URL=https://admin.porterchain.com
# NEXT_PUBLIC_DRIVER_PORTAL_URL=https://driver.porterchain.com
# NEXT_PUBLIC_CUSTOMER_PORTAL_URL=https://customer.porterchain.com

# Admin / merchant / driver / customer portals
# NEXT_PUBLIC_SITE_URL=https://admin.porterchain.com  (per app)
# NEXT_PUBLIC_PORTERCHAIN_API_URL=https://api.porterchain.com

# --- Clerk (production — 4 isolated apps per user class) --------------------
# Legacy single-app: set CLERK_* only. Enterprise: set all CLERK_{PORTAL}_* below.
# JWKS URL: Clerk Dashboard → API Keys → Advanced → JWKS Endpoint

# CLERK_PUBLISHABLE_KEY=pk_live_…
# CLERK_SECRET_KEY=sk_live_…
# CLERK_JWKS_URL=https://….clerk.accounts.dev/.well-known/jwks.json

# Customer (website + customer portal + customer mobile)
# CLERK_CUSTOMER_PUBLISHABLE_KEY=pk_live_…
# CLERK_CUSTOMER_SECRET_KEY=sk_live_…
# CLERK_CUSTOMER_JWKS_URL=https://….clerk.accounts.dev/.well-known/jwks.json

# Merchant portal
# CLERK_MERCHANT_PUBLISHABLE_KEY=pk_live_…
# CLERK_MERCHANT_SECRET_KEY=sk_live_…
# CLERK_MERCHANT_JWKS_URL=https://….clerk.accounts.dev/.well-known/jwks.json

# Admin portal
# CLERK_ADMIN_PUBLISHABLE_KEY=pk_live_…
# CLERK_ADMIN_SECRET_KEY=sk_live_…
# CLERK_ADMIN_JWKS_URL=https://….clerk.accounts.dev/.well-known/jwks.json

# Driver portal + driver mobile
# CLERK_DRIVER_PUBLISHABLE_KEY=pk_live_…
# CLERK_DRIVER_SECRET_KEY=sk_live_…
# CLERK_DRIVER_JWKS_URL=https://….clerk.accounts.dev/.well-known/jwks.json

# --- ZeptoMail transactional (Canada) — HTTPS API, not Zoho Mail SMTP ---------
# DigitalOcean blocks outbound SMTP. Production DeliveryService uses HTTPS when
# MAIL_TRANSPORT=https (or auto + MAIL_HOST contains zeptomail, non-local).
# Token lives in gitignored mail-keys.local.env, then:
#   bash infrastructure/deploy/scripts/upload-mail-to-doppler.sh
# From addresses must be verified Agent aliases in the ZeptoMail CA agent.
MAIL_MAILER=smtp
MAIL_HOST=smtp.zeptomail.ca
MAIL_PORT=587
MAIL_USERNAME=emailapikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TRANSPORT=https
ZEPTOMAIL_API_URL=https://api.zeptomail.ca/v1.1/email
MAIL_FROM_ADDRESS=noreply@porterchain.com
MAIL_FROM_ADDRESS2=sales@porterchain.com
MAIL_FROM_ADDRESS3=ravi@porterchain.com
MAIL_FROM_NAME=Porterchain
PORTERCHAIN_OPS_EMAILS=ops@porterchain.com

# --- Clerk Dashboard redirect allowlists ---------------------------------------
# https://porterchain.com/*
# https://admin.porterchain.com/*
# https://merchant.porterchain.com/*
# https://driver.porterchain.com/*
# https://customer.porterchain.com/*
