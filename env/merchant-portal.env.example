# =============================================================================
# MERCHANT PORTAL — Next.js B2B dashboard (port 3001)
# Copy to: apps/merchant-portal/.env.local
# =============================================================================

# Keycloak OIDC (L36) — realm porterchain, public client pc-merchant-portal (PKCE). Tokens stay server-side
# in an encrypted httpOnly cookie; AUTH_SESSION_SECRET (32+ random chars) comes from SOPS.
KEYCLOAK_URL=http://localhost:8180
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=porterchain
KEYCLOAK_CLIENT_ID=pc-merchant-portal
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=pc-merchant-portal
AUTH_SESSION_SECRET=
AUTH_SIGN_IN_PATH=/sign-in
# Social shortcuts on our sign-in page (Keycloak's page always lists every enabled IdP).
NEXT_PUBLIC_AUTH_IDPS=google,apple
# Production: https://auth.porterchain.com
# Local only — skip sign-in; API must run with AUTH_DEV_BYPASS=true.
# NEXT_PUBLIC_AUTH_DEV_BYPASS=true

# --- REQUIRED — API ----------------------------------------------------------

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
PORTERCHAIN_API_URL=http://localhost:8001

# --- REQUIRED — Stripe checkout --------------------------------------------

PORTERCHAIN_STRIPE_SUCCESS_URL=http://localhost:3001/invoices?paid=1
PORTERCHAIN_STRIPE_CANCEL_URL=http://localhost:3001/invoices?cancelled=1

# --- OPTIONAL — site URL -----------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- OPTIONAL — Google Maps (order tracking map) ------------------------------
# Use the same browser-restricted key as admin/website.
# In Google Cloud Console → Credentials → your Maps JavaScript API key →
# Application restrictions → HTTP referrers, add:
#   http://localhost:3001/*
#   http://127.0.0.1:3001/*
#   https://merchant.porterchain.com/*   (production)


# --- OPTIONAL — monitoring ---------------------------------------------------

# NEXT_PUBLIC_SENTRY_DSN=
