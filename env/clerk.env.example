# =============================================================================
# CLERK — source of truth for local sync (pnpm clerk:sync)
# Copy to: env/clerk.env  (gitignored)
# =============================================================================
#
# Mode: platform_driver — TWO Clerk applications
#
#   PorterChain Platform  → CLERK_ADMIN_* / CLERK_* triad
#     website · customer · merchant · admin (admin leaves Clerk in later phase)
#   Porterchain Driver    → CLERK_DRIVER_* only (invite-only Dashboard)
#
# CLERK_MODE=unified collapses Driver into Platform — do NOT use for this layout.
# CLERK_MODE=enterprise (4 unrelated apps) remains retired.
#
# Local = pk_test / sk_test only. Production = Doppler via clerk-keys.local.env.
# See canvases/professional-auth-architecture.canvas.tsx
# =============================================================================

CLERK_MODE=platform_driver

# -----------------------------------------------------------------------------
# PorterChain Platform (required) — development instance
# Prefer CLERK_* triad; if empty, sync derives from CLERK_ADMIN_*
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

CLERK_ADMIN_PUBLISHABLE_KEY=
CLERK_ADMIN_SECRET_KEY=
CLERK_ADMIN_JWKS_URL=

# Customer / Merchant — filled by sync from Platform (leave blank in source)
CLERK_CUSTOMER_PUBLISHABLE_KEY=
CLERK_CUSTOMER_SECRET_KEY=
CLERK_CUSTOMER_JWKS_URL=

CLERK_MERCHANT_PUBLISHABLE_KEY=
CLERK_MERCHANT_SECRET_KEY=
CLERK_MERCHANT_JWKS_URL=

# -----------------------------------------------------------------------------
# Porterchain Driver (required) — separate Clerk app (invite-only)
# Must differ from Platform in production. Local may temporarily match Platform
# until a Driver development instance exists.
# -----------------------------------------------------------------------------
CLERK_DRIVER_PUBLISHABLE_KEY=
CLERK_DRIVER_SECRET_KEY=
CLERK_DRIVER_JWKS_URL=

# -----------------------------------------------------------------------------
# Optional API JWT / webhook policy (prod: clerk-keys.local.env → Doppler)
# Run: bash infrastructure/deploy/scripts/validate-clerk-keys.sh
# (prints suggested ISSUERS from JWKS URLs when empty)
# Admin portal uses staff IdP — omit admin.porterchain.com from PARTIES.
# -----------------------------------------------------------------------------
# CLERK_AUTHORIZED_PARTIES=https://porterchain.com,https://merchant.porterchain.com,https://driver.porterchain.com,https://customer.porterchain.com
# CLERK_AUTHORIZED_ISSUERS=https://clerk.admin.porterchain.com,https://clerk.driver.porterchain.com
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
