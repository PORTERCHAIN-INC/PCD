# =============================================================================
# CLERK — source of truth for local sync (pnpm clerk:sync)
# Copy to: env/clerk.env  (gitignored)
# =============================================================================
#
# Unified only — one PorterChain Platform app (renamed from Porterchain Admin).
# Same pk/sk/jwks for all portals. CLERK_MODE=enterprise is retired.
# See docs/runbooks/clerk-consolidation.md
#
# Do not put secret keys in NEXT_PUBLIC_* or EXPO_PUBLIC_* (sync keeps sk server-only).
# Do not delete Clerk apps or mutate Doppler prd from agents — founder-owned.
# =============================================================================

CLERK_MODE=unified

# -----------------------------------------------------------------------------
# PorterChain Platform triad (required)
# Prefer these; if empty, sync derives from CLERK_ADMIN_* below.
# Aliases: CLERK_UNIFIED_PUBLISHABLE_KEY / CLERK_UNIFIED_SECRET_KEY / CLERK_UNIFIED_JWKS_URL
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# -----------------------------------------------------------------------------
# Portal slot names (compat) — sync overwrites these with Platform triad
# Platform = ex Admin keys when triad above is empty
# -----------------------------------------------------------------------------

# Admin / Platform (relaxing-warthog-11 locally)
CLERK_ADMIN_PUBLISHABLE_KEY=
CLERK_ADMIN_SECRET_KEY=
CLERK_ADMIN_JWKS_URL=

# Customer / Merchant / Driver — filled by sync from Platform
CLERK_CUSTOMER_PUBLISHABLE_KEY=
CLERK_CUSTOMER_SECRET_KEY=
CLERK_CUSTOMER_JWKS_URL=

CLERK_MERCHANT_PUBLISHABLE_KEY=
CLERK_MERCHANT_SECRET_KEY=
CLERK_MERCHANT_JWKS_URL=

CLERK_DRIVER_PUBLISHABLE_KEY=
CLERK_DRIVER_SECRET_KEY=
CLERK_DRIVER_JWKS_URL=
