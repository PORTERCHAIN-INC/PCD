# =============================================================================
# DRIVER WEB PORTAL — Next.js (port 3003)
# Copy to: apps/driver-portal/.env.local
# =============================================================================

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Local — email picker on /login (API needs CLERK_DEV_BYPASS=true for /auth/dev-*)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_DRIVER_DEV_LOGIN=true

# Google Maps (display only — routing via Porterchain API)
# Clerk — porterchain-driver Clerk application (login + invite flow)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production: Porterchain Driver instance (clerk.driver.porterchain.com) — CLERK_DRIVER_PUBLISHABLE_KEY /
# CLERK_DRIVER_SECRET_KEY. Same Clerk app as the driver mobile app (deploy.yml injects it for the driver image).
