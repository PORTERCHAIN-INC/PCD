# =============================================================================
# DRIVER WEB PORTAL — Next.js (port 3003)
# Copy to: apps/driver-portal/.env.local
# =============================================================================

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Local — email picker on /login (API needs AUTH_DEV_BYPASS=true for /auth/dev-*)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_DRIVER_DEV_LOGIN=true

# Google Maps (display only — routing via Porterchain API)
# Keycloak OIDC (L36) — realm porterchain, public client pc-driver-portal (PKCE). Tokens stay server-side
# in an encrypted httpOnly cookie; AUTH_SESSION_SECRET (32+ random chars) comes from SOPS.
KEYCLOAK_URL=http://localhost:8180
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=porterchain
KEYCLOAK_CLIENT_ID=pc-driver-portal
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=pc-driver-portal
AUTH_SESSION_SECRET=
AUTH_SIGN_IN_PATH=/login
# Social shortcuts on our sign-in page (Keycloak's page always lists every enabled IdP).
NEXT_PUBLIC_AUTH_IDPS=google,apple
# Production: https://auth.porterchain.com
