EXPO_PUBLIC_API_URL=http://127.0.0.1:8001
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ALLOW_DEV_AUTH=true
# Filled by pnpm clerk:sync. Put the same driver publishable key on the EAS
# development / preview / production environments — never commit the secret.
# iOS FCM: eas build --profile development-device (physical phone, not simulator).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
