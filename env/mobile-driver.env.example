EXPO_PUBLIC_API_URL=http://127.0.0.1:8001
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ALLOW_DEV_AUTH=true
# Keycloak (public client pc-driver-app; no secret). Set the same values on EAS envs.
# iOS FCM: eas build --profile development-device (physical phone, not simulator).
EXPO_PUBLIC_KEYCLOAK_URL=http://127.0.0.1:8180
EXPO_PUBLIC_KEYCLOAK_REALM=porterchain
