# =============================================================================
# DOCKER COMPOSE — shared secrets for local full stack
# Copy to: .env (repo root) for docker compose --env-file .env
# See: DOCKER_ARCHITECTURE.md
# =============================================================================

# --- MySQL -------------------------------------------------------------------

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fleetbase
MYSQL_USER=fleetbase
MYSQL_PASSWORD=change-me-fleetbase

# Maps to fleetbase.env: DB_* vars

# --- Redis -------------------------------------------------------------------

REDIS_PASSWORD=

# --- Fleetbase Laravel -------------------------------------------------------

APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# --- Porterchain bridge ------------------------------------------------------

PORTERCHAIN_FLEETBASE_DEFAULT_COMPANY_UUID=
PORTERCHAIN_DISPATCHER_API_KEY=change-me-dispatcher-key

# --- Stripe (shared by API + Fleetbase) --------------------------------------

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Clerk -------------------------------------------------------------------

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# --- Google Maps -------------------------------------------------------------

GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# --- SMTP / Firebase — see api.env.example for full list ---------------------
