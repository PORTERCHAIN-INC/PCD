# =============================================================================
# WORKER — async queue processor
# Copy to: apps/worker/.env
# =============================================================================

APP_ENV=local
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379/0

# SMTP (email queue)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASSWORD=
SMTP_FROM=noreply@porterchain.com

# Firebase (push queue) — same project as API
FIREBASE_PROJECT_ID=
# Prefer JSON in worker containers; path works for local file mounts
FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_PATH=

# Master switches (shared Settings aliases with API)
PORTERCHAIN_PUSH_ENABLED=true
# false = dry-run / log-only (safe local default); true to hit FCM
PORTERCHAIN_PUSH_SEND=false

# Driver compliance expiry sweep uses API Settings (apps/api/.env):
# DRIVER_COMPLIANCE_EXPIRY_SWEEP_ENABLED=true
