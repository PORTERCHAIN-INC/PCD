# =============================================================================
# WORKER — async queue processor
# Copy to: apps/worker/.env
# =============================================================================

APP_ENV=local
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379/0

# SMTP (email queue)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASSWORD=
SMTP_FROM=noreply@porterchain.com

# Firebase (push queue)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
