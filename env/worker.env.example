# =============================================================================
# WORKER — async queue processor
# Copy to: apps/worker/.env
# =============================================================================

APP_ENV=local
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379/0

# SMTP (email queue)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@porterchain.com

# Twilio (SMS queue)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase (push queue)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
