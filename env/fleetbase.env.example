# =============================================================================
# FLEETBASE — Laravel API (:8000). Ember console is not used.
# Copy to: services/fleetbase/.env or Docker Compose env_file
# =============================================================================

# --- REQUIRED — Laravel core -------------------------------------------------

APP_NAME="PORTERCHAIN INC."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=daily
LOG_LEVEL=debug

# --- REQUIRED — MySQL --------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=fleetbase
DB_USERNAME=fleetbase
DB_PASSWORD=

# From host machine (outside Docker): DB_HOST=127.0.0.1

# --- REQUIRED — Redis ----------------------------------------------------------

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=null

# From host machine: REDIS_HOST=127.0.0.1

# --- REQUIRED — session & filesystem -----------------------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
FILESYSTEM_DRIVER=public
BROADCAST_DRIVER=socketcluster

# --- REQUIRED — Fleetbase URLs -----------------------------------------------

FLEETBASE_API_URL=http://localhost:8000
REGISTRY_HOST=https://registry.fleetbase.io

# --- REQUIRED — branding -----------------------------------------------------

BRANDING_LOGO_URL=
BRANDING_ICON_URL=

# --- REQUIRED — routing ------------------------------------------------------

ROUTING_ENGINE=valhalla
OSRM_HOST=http://localhost:5000
VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_BASE_URI=http://localhost:8002

# --- REQUIRED — Porterchain bridge ---------------------------------------------

PORTERCHAIN_API_URL=http://localhost:8001
PORTERCHAIN_FLEETBASE_DEFAULT_COMPANY_UUID=
PORTERCHAIN_FLEETBASE_ASSIGNMENT_REQUIRED=true
PORTERCHAIN_FLEETBASE_DISPATCH_BRIDGE=true
PORTERCHAIN_FLEETBASE_DRIVER_JOB_BRIDGE=true
PORTERCHAIN_DISPATCHER_API_KEY=change-me-dispatcher-key

# --- REQUIRED — Google Maps (server) -----------------------------------------

GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_LOCALE=us

# --- REQUIRED — Stripe ---------------------------------------------------------

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PORTERCHAIN_STRIPE_SUCCESS_URL=http://localhost:3001/invoices?paid=1
PORTERCHAIN_STRIPE_CANCEL_URL=http://localhost:3001/invoices?cancelled=1

# --- REQUIRED — Clerk ----------------------------------------------------------

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# --- REQUIRED — mail -----------------------------------------------------------

MAIL_MAILER=smtp
MAIL_HOST=smtp.zohocloud.ca
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=ops@porterchain.com
MAIL_FROM_NAME=Porterchain

# --- REQUIRED — Porterchain notifications ------------------------------------

PORTERCHAIN_FROM_EMAIL=ops@porterchain.com
PORTERCHAIN_FROM_NAME=Porterchain
PORTERCHAIN_TRACKING_URL=http://localhost:3000/track/
PORTERCHAIN_OPS_EMAILS=ops@porterchain.com

# Retail billing
PORTERCHAIN_RETAIL_PAY_URL_BASE=http://localhost:3000/track
PORTERCHAIN_RETAIL_STRIPE_SUCCESS_URL=http://localhost:3000/track/{tracking_number}?paid=1
PORTERCHAIN_RETAIL_STRIPE_CANCEL_URL=http://localhost:3000/track/{tracking_number}?cancelled=1

# --- OPTIONAL — Firebase FCM -------------------------------------------------

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/fleetbase/api/storage/app/firebase/service-account.json
PORTERCHAIN_DRIVER_PUSH_ENABLED=true
PORTERCHAIN_DRIVER_PUSH_SEND=true
