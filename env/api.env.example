# =============================================================================
# PORTERCHAIN API — FastAPI (port 8001 recommended)
# Copy to: apps/api/.env
# =============================================================================

# --- REQUIRED — core ---------------------------------------------------------

APP_ENV=local
# Project mode (Jeff Dean): boot-time SoT — change via `pnpm mode:set development|testing|production`, then restart.
#   development → APP_ENV=local   (laptop; CLERK_DEV_BYPASS / STRIPE_MOCK only here)
#   testing     → APP_ENV=test    (CI; no auth bypass)
#   production  → APP_ENV=production|staging (fail-closed; never flip from Admin UI)
APP_DEBUG=true
LOG_LEVEL=debug
PORTERCHAIN_API_URL=http://localhost:8001
PORTERCHAIN_API_PORT=8001

# CORS — all local frontends (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Porterchain database (owned data — PostgreSQL)
DATABASE_URL=postgresql+psycopg://porterchain:porterchain@localhost:5432/porterchain

# --- OPTIONAL — PostgreSQL pool tuning (defaults: size=10, overflow=20) ---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Replica — optional; analytics read paths only (§3.4.7)
# DATABASE_URL_REPLICA=postgresql+psycopg://user:pass@replica-host:5432/porterchain?sslmode=require

# --- REQUIRED — Clerk JWT verification (sole auth provider) ------------------
# DEFAULT: PorterChain Platform (single app, ex Porterchain Admin).
# Set CLERK_* triad + CLERK_UNIFIED_MODE=true (pnpm clerk:sync — unified only).
# Portal slot names below are expanded to the same Platform keys.

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
# Local dev only — requires APP_ENV=local. Never enable in staging/production.
CLERK_DEV_BYPASS=false

# Portal slot names (compat) — same Platform secret/JWKS in unified mode.
CLERK_CUSTOMER_SECRET_KEY=
CLERK_CUSTOMER_JWKS_URL=
CLERK_CUSTOMER_PUBLISHABLE_KEY=
CLERK_MERCHANT_SECRET_KEY=
CLERK_MERCHANT_JWKS_URL=
CLERK_MERCHANT_PUBLISHABLE_KEY=
# Admin portal is staff IdP — pnpm clerk:sync clears these on purpose. Do not copy Doppler admin keys here.
CLERK_ADMIN_SECRET_KEY=
CLERK_ADMIN_JWKS_URL=
CLERK_ADMIN_PUBLISHABLE_KEY=
CLERK_DRIVER_SECRET_KEY=
CLERK_DRIVER_JWKS_URL=
CLERK_DRIVER_PUBLISHABLE_KEY=

# Optional JWT policy — empty skips checks
# CLERK_AUDIENCE=
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,https://porterchain.com,https://merchant.porterchain.com,https://driver.porterchain.com,https://customer.porterchain.com
# CLERK_AUTHORIZED_ISSUERS=  # derive from JWKS via validate-clerk-keys.sh
# Primary auth domain (Clerk Dashboard / DNS): auth.porterchain.com when available

# Clerk webhooks — Svix signing secret from Platform Clerk dashboard
# CLERK_WEBHOOK_SIGNING_SECRET=

SPICEDB_ENABLED=true
# Local: soft fallback to in-process memory if SpiceDB is down.
# Production (docker-compose.prod.yml): defaults to SPICEDB_REQUIRED=true — fail closed.
SPICEDB_REQUIRED=false
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_PRESHARED_KEY=porterchain-spicedb-dev-key
# SPICEDB_USE_MEMORY=true

# Portal URLs — Clerk invitation redirect targets
ADMIN_PORTAL_URL=http://localhost:3002
MERCHANT_PORTAL_URL=http://localhost:3001
DRIVER_PORTAL_URL=http://localhost:3003
CUSTOMER_PORTAL_URL=http://localhost:3004
WEBSITE_URL=http://localhost:3000

# Shared with website WEBSITE_REVALIDATE_SECRET — bumps blog ISR after CMS publish
WEBSITE_REVALIDATE_SECRET=

# Optional CDN/origin for blog cover + body images (no trailing slash).
# Leave empty for local/API disk via /v1/public/blog/media/…
# Example prod: https://media.porterchain.com  (R2 public / custom domain)
BLOG_MEDIA_PUBLIC_BASE_URL=
# Optional override for on-disk store (default: apps/api/data/blog-media)
# BLOG_MEDIA_DIR=
# Optional S3-compatible mirror (Cloudflare R2). When set, uploads also PUT to the bucket.
# BLOG_MEDIA_S3_ENDPOINT=https://ACCOUNTID.r2.cloudflarestorage.com
# BLOG_MEDIA_S3_BUCKET=porterchain-blog
# BLOG_MEDIA_S3_ACCESS_KEY_ID=
# BLOG_MEDIA_S3_SECRET_ACCESS_KEY=
# BLOG_MEDIA_S3_REGION=auto
# BLOG_MEDIA_S3_PREFIX=blog-media
BLOG_MEDIA_S3_ENDPOINT=
BLOG_MEDIA_S3_BUCKET=
BLOG_MEDIA_S3_ACCESS_KEY_ID=
BLOG_MEDIA_S3_SECRET_ACCESS_KEY=
BLOG_MEDIA_S3_REGION=auto
BLOG_MEDIA_S3_PREFIX=blog-media

# Website form ingest — same value in website/.env.local (server-side only)
PUBLIC_INGEST_API_KEY=

# --- OPTIONAL — multi-channel lead webhooks (Lead Ingest Bus) ----------------
# Meta Lead Ads / Instagram / Facebook / WhatsApp Cloud (Graph).
# Callback: GET/POST {API}/v1/public/leads/webhooks/meta
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# Google Ads lead form / GBP messaging — header X-Lead-Webhook-Secret
# Callback: POST {API}/v1/public/leads/webhooks/google
# GOOGLE_LEAD_WEBHOOK_SECRET=
# LinkedIn / X / YouTube — same header secret
# Callbacks: POST {API}/v1/public/leads/webhooks/{linkedin,x,youtube}
# SOCIAL_LEAD_WEBHOOK_SECRET=
# CRM offline conversions on lead convert
# META_CAPI_ACCESS_TOKEN=
# META_PIXEL_ID=
# LINKEDIN_CAPI_TOKEN=
# LINKEDIN_CONVERSION_URN=urn:lla:llaPartnerConversion:000000
# Auto-assign: {"ON":"<admin_user_id>","GTA":"<admin_user_id>","DEFAULT":"<admin_user_id>"}
# LEAD_TERRITORY_MAP_JSON=
# LEAD_ROUND_ROBIN_JSON=["admin-id-1","admin-id-2"]
# LEAD_SLA_MINUTES_JSON={"whatsapp":15,"phone_call":30,"default":60}
# Zero-human lead agent (auto welcome email when marketing consent). Kill switch:
# LEAD_AGENT_AUTO_SEND=false  # default off: drafts wait for staff approval
# Meta WhatsApp Cloud outbound (optional — inbound webhook works without these):
# META_WA_ACCESS_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_BUSINESS_ACCOUNT_ID=
# META_WA_TEMPLATE_MAP_JSON={"lead_welcome":"lead_welcome","lead_nurture_intro":"lead_welcome"}
# LEAD_INGEST_ASYNC=false
# REFERRAL_CREDIT_CENTS=25000
# Doppler: bash infrastructure/deploy/scripts/upload-leads-to-doppler.sh
# Checklist: infrastructure/deploy/SECRETS.md
# Admin Settings → Lead Ingest write-through (service token; never commit)
# DOPPLER_TOKEN=
# PORTERCHAIN_DOPPLER_PROJECT=pcd
# PORTERCHAIN_DOPPLER_CONFIG=prd

DISPATCH_ENGINE=porterchain

# Shopify (OAuth public app). Custom apps can paste Admin API token in the portal without these.
# Partner App URL (prod): https://merchant.porterchain.com/shopify
# Allowed redirection URL: https://api.porterchain.com/v1/integrations/shopify/callback
# Doppler (prod): set SHOPIFY_API_KEY + SHOPIFY_API_SECRET in the API project — never in portal env.
# Tokens at rest are Fernet-encrypted (merchant secrets key); portal connection_payload never returns them.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
# Optional override; default includes write_shipping for CarrierService rates.
# SHOPIFY_API_SCOPES=read_orders,write_fulfillments,write_shipping,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders
# SHOPIFY_CARRIER_RATE_LIMIT_PER_MINUTE=120
# SHOPIFY_WEBHOOK_RATE_LIMIT_PER_MINUTE=300
# FO foundation (default off). When true: register FulfillmentService + FO webhooks + notification enqueue stub. Accept→book still held.
# SHOPIFY_FULFILLMENT_SERVICE_ENABLED=false

# --- PRODUCTION — assignment gate --------------------------------------------


# --- REQUIRED — Stripe (server only — never in website .env) -----------------
# Doppler (prod): STRIPE_SECRET + STRIPE_WEBHOOK_SECRET on API; publishable key on portals only.
# Local receipts/reminders: Mailpit (not Mailhog) — SMTP from worker/API mail settings.

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# P0 driver license auto-verify (Stripe Identity). Local: enable + stripe mock.
# DRIVER_IDENTITY_VERIFICATION_ENABLED=true
# DRIVER_IDENTITY_RETURN_URL=http://localhost:3003/profile?identity=return
# P1 background screening (Checkr Canada). Local: enable + checkr mock.
# DRIVER_BACKGROUND_CHECK_ENABLED=true
# CHECKR_API_KEY=
# CHECKR_WEBHOOK_SECRET=
# CHECKR_PACKAGE_SLUG=driver_pro
# CHECKR_MOCK=true
# P2 Ontario abstract attestation + compliance expiry sweep
# DRIVER_ABSTRACT_VERIFICATION_ENABLED=true
# DRIVER_ABSTRACT_MAX_DEMERITS=8
# DRIVER_ABSTRACT_ALLOWED_CLASSES=G,A,B,C,D,E,F
# DRIVER_COMPLIANCE_EXPIRY_SWEEP_ENABLED=true


# Merchant invoice checkout redirects (portal Billing)
PORTERCHAIN_STRIPE_SUCCESS_URL=http://localhost:3001/billing?tab=invoices&paid=1
PORTERCHAIN_STRIPE_CANCEL_URL=http://localhost:3001/billing?tab=invoices&cancelled=1

# Retail pay-after-delivery (website tracking page)
PORTERCHAIN_RETAIL_PAY_URL_BASE=http://localhost:3000/track
PORTERCHAIN_RETAIL_STRIPE_SUCCESS_URL=http://localhost:3000/track/{tracking_number}?paid=1
PORTERCHAIN_RETAIL_STRIPE_CANCEL_URL=http://localhost:3000/track/{tracking_number}?cancelled=1

# --- REQUIRED — Google Maps (server / IP-restricted keys) --------------------

GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- REQUIRED — routing (server-side) ----------------------------------------

ROUTING_ENGINE=valhalla
# 127.0.0.1 only. macOS AirPlay owns non-loopback :5000.
OSRM_HOST=http://127.0.0.1:5000
# Last-resort public demo is MapsService-only and off by default:
# OSRM_ALLOW_PUBLIC_DEMO=false
VALHALLA_BASE_URL=http://127.0.0.1:8002

# --- REQUIRED — notifications ------------------------------------------------

PORTERCHAIN_TRACKING_URL=http://localhost:3000/track/
PORTERCHAIN_OPS_EMAILS=ops@porterchain.com

# Platform mail — local Mailpit only. Production is ZeptoMail HTTPS
# (smtp.zeptomail.ca + MAIL_TRANSPORT=https). See env/production.env.example.
# Do not point this file at smtp.zohocloud.ca — that is Zoho Mail inbox SMTP, not transactional.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=ops@porterchain.com
MAIL_FROM_ADDRESS2=sales@porterchain.com
MAIL_FROM_ADDRESS3=ravi@porterchain.com
MAIL_FROM_NAME=Porterchain (local)

# --- REQUIRED — driver onboarding (invite emails) ------------------------------

DRIVER_PORTAL_BASE_URL=http://localhost:3003

# --- OPTIONAL — Firebase FCM (driver push from API) --------------------------
# File lives next to the API (gitignored). The process reads apps/api/.env only — not env/.env.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=.secrets/firebase-service-account.json
PORTERCHAIN_PUSH_ENABLED=false
PORTERCHAIN_PUSH_SEND=false

# --- OPTIONAL — SMS (Twilio) ---------------------------------------------------
# PORTERCHAIN_SMS_ENABLED=true
# PORTERCHAIN_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- OPTIONAL — NVIDIA NIM (ops LLM / intelligence_engine; not on pay path) ----
# Free cloud: create a key at https://build.nvidia.com/settings/api-keys (~40 RPM).
# NVIDIA_API_KEY=
# NGC_API_KEY=
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=openai/gpt-oss-20b
#
# Self-hosted NIM fallback (when free RPM saturates): point NVIDIA_API_BASE at your
# OpenAI-compatible NIM container / cluster. Same NVIDIA_MODEL id your deploy serves.
# Auth: set NVIDIA_API_KEY to the local token, or any non-empty value if the endpoint
# does not require Bearer auth (client always sends Authorization).
# NVIDIA_API_BASE=http://127.0.0.1:8000/v1
# NVIDIA_MODEL=openai/gpt-oss-20b
#
# Enable enrichers / Ask NIM: PORTERCHAIN_PHASE2_INTELLIGENCE=true (never on pay path).
#

# --- OPTIONAL — database (if API uses PostgreSQL) ------------------------------

# DATABASE_URL=postgresql://porterchain:password@localhost:5432/porterchain_api

# --- OPTIONAL — Redis (rate limits, cache) -----------------------------------


# --- OPTIONAL — infrastructure -----------------------------------------------

# DIGITALOCEAN_API_TOKEN=
# SENTRY_DSN=

# Driver mobile store gate (GET /health/status → mobile.driver)
# DRIVER_APP_MIN_VERSION=1.0.0
# DRIVER_APP_FORCE_UPDATE=false
# DRIVER_APP_STORE_URL_IOS=https://apps.apple.com/app/porterchain-driver
# DRIVER_APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.porterchain.PCD
# DRIVER_APP_UPDATE_MESSAGE=A required update is available for the Porterchain Driver app.

# Readiness audit (Oct 2026)
# /docs, /redoc, /openapi.json are off outside local/dev/test unless this is true.
# API_DOCS_ENABLED=false
# Proof of delivery + on-shift gate on dropoff completion (default ON). "false" = kill switch.
# DRIVER_POD_ENFORCED=true
# DRIVER_DUTY_REQUIRED_FOR_COMPLETION=true
