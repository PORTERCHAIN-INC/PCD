# =============================================================================
# CUSTOMER PORTAL — standalone Next.js app (port 3004 / customer.porterchain.com)
# Copy to: apps/customer/.env.local
# =============================================================================

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Keycloak OIDC (L36) — realm porterchain, public client pc-customer-portal (PKCE). Tokens stay server-side
# in an encrypted httpOnly cookie; AUTH_SESSION_SECRET (32+ random chars) comes from SOPS.
KEYCLOAK_URL=http://localhost:8180
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=porterchain
KEYCLOAK_CLIENT_ID=pc-customer-portal
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=pc-customer-portal
AUTH_SESSION_SECRET=
AUTH_SIGN_IN_PATH=/sign-in
# Social shortcuts on our sign-in page (Keycloak's page always lists every enabled IdP).
NEXT_PUBLIC_AUTH_IDPS=google,apple
# Production: https://auth.porterchain.com
