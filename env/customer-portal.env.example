# =============================================================================
# CUSTOMER PORTAL — standalone Next.js app (port 3004 / customer.porterchain.com)
# Copy to: apps/customer/.env.local
# =============================================================================

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Clerk — porterchain-customer Clerk application (same as website retail)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production: https://customer.porterchain.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in
