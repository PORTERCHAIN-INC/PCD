@startuml merchant_flow
!theme plain
actor Merchant
participant "Merchant Portal" as APP
participant "API /v1/merchant" as API
participant "MerchantBookingService" as BOOK
participant "MerchantBulkService" as BULK
participant "Order" as ORD
participant "Fleetbase Sync" as FB
participant "MerchantBillingService" as BILL

Merchant -> APP: Clerk auth
APP -> API: HTTPS
API -> BOOK: POST /bookings
BOOK -> ORD: Order BOOKED (MERCHANT)
BOOK -> FB: transition_to_dispatch_ready
API -> BULK: bulk upload / confirm
BULK -> ORD: CSV orders
API -> BILL: GET billing/statement
@enduml
