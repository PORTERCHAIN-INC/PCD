@startuml notification_flow
!theme plain
queue "order.booked / booking.confirmed" as EV
participant "notification_handler" as NH
participant "NotificationOrchestrator" as ORCH
participant "DeliveryService" as DEL
queue "notification.queued" as NQ
participant "apps/worker" as W
cloud "Email/SMS/Push" as CH

EV -> NH
NH -> ORCH
ORCH -> DEL
DEL -> NQ
NQ -> W
W -> CH
@enduml
