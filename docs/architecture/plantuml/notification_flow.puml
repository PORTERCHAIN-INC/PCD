@startuml notification_flow
!theme plain
queue "domain events" as EV
participant "event_router" as ER
participant "NotificationEngine" as ENG
participant "DeliveryService" as DEL
queue "notification.queued" as NQ
participant "apps/worker" as W
cloud "Email/SMS/Push" as CH

EV -> ER
ER -> ENG
ENG -> DEL
DEL -> NQ
NQ -> W
W -> CH
@enduml
