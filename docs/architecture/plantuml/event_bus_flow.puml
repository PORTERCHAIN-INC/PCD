@startuml event_bus_flow
!theme plain
package "Producers" {
  [booking_engine services] as PROD
}
queue "Redis Event Bus" as BUS
package "Handlers" {
  [dispatch_ready → Fleetbase sync] as H1
  [driver_assigned → Fleetbase sync] as H2
  [notifications] as H3
  [payment.succeeded → billing] as H4
  [webhook.received] as H5
  [merchant fanout order.*] as H6
}
node "apps/worker" as W

PROD --> BUS
BUS --> H1
BUS --> H2
BUS --> H3
BUS --> H4
BUS --> H5
BUS --> H6
H4 --> W
H3 --> W
H5 --> W
@enduml
