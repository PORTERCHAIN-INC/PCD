flowchart TB
  subgraph Bond["Permanent bond<br/>identity + handshake + heal"]
    KEY["FLEETBASE_API_KEY<br/>+ company UUID"]
    HB["verify_bond<br/>GET /v1/orders"]
    REPAIR["pnpm fleetbase:bond<br/>repair_fleetbase_local"]
  end

  subgraph Porterchain["Porterchain API"]
    FBE[fleetbase_engine]
    FIB[FleetbaseIntegrationBridge]
    BSS[BookingSyncService]
    WIS[WebhookIngressService]
    WP[WebhookProcessor]
    DE[DriverFleetbaseBridge]
    SSO[SsoService]
    BOND_MOD[bond.py boot handshake]
  end

  subgraph Adapter["fleetbase-adapter<br/>FleetbaseAdapter — only legal wire"]
    ORD[OrderService]
    DRV[DriverService]
    DISP[DispatchService]
    TRK[TrackingService]
    POD[PodService]
    WH[WebhookService]
    SSO_C[FleetbaseSsoClient]
    CLI[FleetbaseClient]
    VB[verify_bond]
  end

  subgraph FB["Fleetbase :8000 — upstream, never forked"]
    FB_ORD[Orders API]
    FB_DISP[Dispatch]
    FB_GPS[GPS / Tracking]
    FB_POD[POD]
    FB_CONSOLE[Console :4200]
  end

  KEY --> CLI
  BOND_MOD --> VB --> CLI
  HB --> VB
  REPAIR -.-> KEY

  BSS --> FIB --> Adapter
  DE --> FIB
  SSO --> SSO_C
  WIS --> WH
  WP --> TRK & POD
  ORD & DRV & DISP & TRK & POD --> CLI --> FB_ORD & FB_DISP & FB_GPS & FB_POD
  SSO_C --> FB_CONSOLE
