{
  "name": "@porterchain/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Porterchain tooling configuration",
  "exports": {
    "./prettier": "./prettier.config.mjs",
    "./monorepo-env.mjs": {
      "types": "./monorepo-env.d.ts",
      "default": "./monorepo-env.mjs"
    },
    "./sentry/portal": {
      "types": "./sentry/portal.ts",
      "default": "./sentry/portal.ts"
    },
    "./phase2": {
      "types": "./phase2.ts",
      "default": "./phase2.mjs"
    }
  },
  "files": [
    "prettier.config.mjs",
    "monorepo-env.mjs",
    "monorepo-env.d.ts",
    "sentry/portal.ts",
    "phase2.mjs",
    "phase2.ts",
    "tsconfig.base.json"
  ],
  "dependencies": {
    "@sentry/nextjs": "^10.64.0"
  }
}
