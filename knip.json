{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,mjs,ts}"],
      "ignoreBinaries": ["alembic", "pytest", "stripe", "k6", "tsc"]
    },
    "apps/admin": {
      "entry": ["e2e/**/*.spec.ts"],
      "ignore": ["public/firebase-messaging-sw.js"]
    },
    "apps/driver-portal": {
      "ignore": ["public/firebase-messaging-sw.js"]
    },
    "apps/merchant-portal": {
      "entry": [
        "e2e-review/**/*.spec.ts",
        "playwright.review.config.ts",
        "src/i18n/jsx-runtime.ts",
        "src/i18n/jsx-dev-runtime.ts"
      ],
      "ignore": ["public/firebase-messaging-sw.js"]
    },
    "apps/customer": {
      "ignore": ["src/lib/visitor-session.ts"],
      "entry": ["src/i18n/jsx-runtime.ts", "src/i18n/jsx-dev-runtime.ts"]
    },
    "apps/mobile-customer": {
      "ignore": ["vendor/**"],
      "ignoreDependencies": [
        "expo-updates",
        "expo-system-ui",
        "expo-auth-session",
        "expo-constants"
      ]
    },
    "apps/mobile-driver": {
      "ignore": ["vendor/**"],
      "ignoreDependencies": ["expo-updates", "expo-system-ui", "expo-auth-session"],
      "ignoreBinaries": ["maestro"]
    },
    "packages/config": {
      "entry": ["*.test.mjs"]
    },
    "website": {
      "ignore": ["src/lib/seo/OWNERSHIP.ts"],
      "ignoreDependencies": ["server-only"],
      "entry": ["e2e-local-stack/**/*.ts"]
    }
  },
  "ignore": ["tests/load/**"],
  "ignoreExportsUsedInFile": true,
  "include": ["files", "dependencies", "unlisted", "binaries", "exports", "duplicates"],
  "ignoreIssues": {
    "apps/admin/src/lib/env.ts": ["exports"],
    "apps/mobile-driver/src/ui/RouteStopCard.tsx": ["exports"],
    "packages/events/src/catalog.ts": ["exports"],
    "website/src/components/seo/index.ts": ["exports"],
    "website/src/lib/blog.ts": ["exports"],
    "website/src/lib/marketing/casl.ts": ["exports"],
    "website/src/lib/seo/analytics.ts": ["exports"],
    "website/src/lib/seo/attribution.ts": ["exports"],
    "website/src/lib/seo/page-helpers.ts": ["exports"],
    "website/src/lib/seo/redirects.ts": ["exports"],
    "website/src/lib/seo/routes.ts": ["exports"],
    "website/src/lib/seo/schema.ts": ["exports"],
    "website/src/lib/seo/vehicle-page.tsx": ["exports"],
    "apps/customer/tsconfig.json": ["unlisted"],
    "apps/merchant-portal/tsconfig.json": ["unlisted"]
  }
}
