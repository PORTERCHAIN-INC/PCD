{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder:30b-64k",
  "default_agent": "porterchain",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3-coder:30b-64k": {
          "name": "Qwen3 Coder 30B (64k)",
          "tools": true
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pnpm *": "ask",
      "python *": "ask"
    }
  },
  "agent": {
    "porterchain": {
      "description": "Primary PorterChain logistics coding agent — Fleetbase-first, Valhalla/OSRM routing, commercial domain ownership",
      "mode": "primary",
      "model": "ollama/qwen3-coder:30b-64k",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/porterchain.txt}",
      "color": "#0F766E",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "ollama/qwen3-coder:30b-64k",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  },
  "mcp": {
    "lance": {
      "type": "remote",
      "url": "https://api.lance.app/mcp",
      "enabled": true
    }
  }
}
