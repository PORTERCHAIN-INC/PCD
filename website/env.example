# Copy to .env.local for local development
# Full template: ../env/website.env.example

# --- REQUIRED (active today) -------------------------------------------------

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=enterprise@porterchain.com

# --- OPTIONAL ----------------------------------------------------------------

# Groq — welcome Capacity line chat (server-only; never NEXT_PUBLIC_)
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional provider switch: groq (default) | nvidia (NIM free-tier OpenAI-compatible)
# CAPACITY_GUIDE_PROVIDER=groq
# NVIDIA_API_KEY=
# NGC_API_KEY=
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=openai/gpt-oss-20b

# Quote preview routing — match API default (Valhalla primary, OSRM fallback)
ROUTING_ENGINE=valhalla
VALHALLA_BASE_URL=http://localhost:8002

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-VWMZWJ4W4M

NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_MERCHANT_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3004
NEXT_PUBLIC_DRIVER_PORTAL_URL=http://localhost:3003

# SalesIQ stays off. Do not set this true in production (website build must not load the widget).
NEXT_PUBLIC_ZOHO_SALESIQ_ENABLED=false
# NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=

NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/porterchain
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/porterchain/
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61568324733884
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@porterchain
NEXT_PUBLIC_SOCIAL_WHATSAPP=https://wa.me/16476197951

NEXT_PUBLIC_DRIVER_APP_IOS_URL=
NEXT_PUBLIC_DRIVER_APP_ANDROID_URL=
