{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetSuiteItemFulfillment",
  "type": "object",
  "required": ["external_id", "ship_address", "pickup_address", "ship_date"],
  "properties": {
    "external_id": { "type": "string", "description": "NetSuite internal ID or tranid" },
    "tranid": { "type": "string" },
    "purchase_order": { "type": "string" },
    "subsidiary": { "type": "string" },
    "memo": { "type": "string" },
    "ship_date": { "type": "string", "format": "date-time" },
    "ship_address": {
      "type": "object",
      "required": ["formatted"],
      "properties": {
        "formatted": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "pickup_address": {
      "type": "object",
      "required": ["formatted"],
      "properties": {
        "formatted": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "weight_kg": { "type": "number" },
    "vehicle_class": { "type": "string" }
  }
}
