{
  "name": "@porterchain/admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "next dev --port 3002 --turbopack",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:leads": "vitest run src/lib/leads.test.ts src/app/(ops)/leads",
    "test:e2e": "playwright test",
    "test:e2e:p0": "playwright test e2e/auth.p0.spec.ts e2e/pages.p0.spec.ts e2e/drivers.p0.spec.ts e2e/merchants.p0.spec.ts e2e/push.p0.spec.ts e2e/leads.p0.spec.ts --grep @p0",
    "test:e2e:p0:live": "playwright test --grep @p0",
    "test:e2e:leads": "playwright test e2e/leads.p0.spec.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.14",
    "@dnd-kit/core": "^6.3.1",
    "@porterchain/auth": "workspace:*",
    "@porterchain/config": "workspace:*",
    "@porterchain/maps": "workspace:*",
    "@porterchain/types": "workspace:*",
    "@porterchain/ui": "workspace:*",
    "@sentry/nextjs": "^10.64.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@vis.gl/react-google-maps": "^1.9.0",
    "echarts": "^6.1.0",
    "firebase": "12.19.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-config-next": "16.2.10",
    "happy-dom": "20.14.6",
