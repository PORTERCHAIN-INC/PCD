EXPO_PUBLIC_API_URL=http://127.0.0.1:8001
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ALLOW_DEV_AUTH=true
# Keycloak (L36). Empty in dev = dev auth; release defaults to https://auth.porterchain.com
EXPO_PUBLIC_KEYCLOAK_URL=
EXPO_PUBLIC_KEYCLOAK_REALM=porterchain
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=pc-customer-app
# Native Google sign-in (public OAuth client ids, not secrets)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android in-app map (build time only; Maps SDK for Android key restricted to the app). Doppler pcd/prd + EAS env.
GOOGLE_MAPS_ANDROID_API_KEY=
