{
  "expo": {
    "name": "Porterchain Customer",
    "slug": "porterchain-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "porterchain-customer",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.porterchain.customer",
      "associatedDomains": ["applinks:porterchain.com", "applinks:www.porterchain.com"]
    },
    "android": {
      "package": "com.porterchain.customer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "porterchain.com", "pathPrefix": "/track" },
            { "scheme": "https", "host": "www.porterchain.com", "pathPrefix": "/track" },
            { "scheme": "https", "host": "porterchain.com", "pathPrefix": "/en/track" },
            { "scheme": "https", "host": "porterchain.com", "pathPrefix": "/fr/track" },
            { "scheme": "https", "host": "porterchain.com", "pathPrefix": "/login" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
