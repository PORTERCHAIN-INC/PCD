{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8001",
        "EXPO_PUBLIC_APP_KIND": "customer"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.porterchain.com",
        "EXPO_PUBLIC_APP_KIND": "customer"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.14.0",
      "distribution": "store",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2",
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.porterchain.com",
        "EXPO_PUBLIC_APP_KIND": "customer",
        "NPM_CONFIG_ENGINE_STRICT": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "iot.ravichauhan@gmail.com",
        "appleTeamId": "4XWFT5A8C3"
      }
    }
  }
}
