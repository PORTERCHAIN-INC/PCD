# =============================================================================
# DRIVER APP — Expo SDK 52 (apps/mobile-driver)
# Copy to: apps/mobile-driver/.env
# Never commit .env, credentials/, or *.p8
# =============================================================================

# --- REQUIRED — API (inlined at build time by Metro/EAS) ---------------------

EXPO_PUBLIC_API_URL=http://127.0.0.1:8001

# Physical device on LAN: http://<YOUR_LAN_IP>:8001
# Android emulator → host: http://10.0.2.2:8001
# EAS preview/production: https://api.porterchain.com (set in eas.json)

# --- REQUIRED — Google Maps (iOS + Android SDK keys) -------------------------

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Restrict in GCP: bundle ID com.porterchain.PCD
# EAS production: npx eas-cli secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY

# --- SUBMIT ONLY — App Store Connect API -------------------------------------

APPLE_ASC_KEY_PATH=./credentials/AuthKey.p8
APPLE_ASC_KEY_ID=VS6W73BSA6
APPLE_ASC_ISSUER_ID=

# --- OPTIONAL — CI / deploy --------------------------------------------------

EXPO_TOKEN=
VERIFY_ASC_KEY=1
