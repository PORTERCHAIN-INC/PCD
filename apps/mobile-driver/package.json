{
  "name": "@porterchain/mobile-driver",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "EXPO_PUBLIC_API_URL=http://10.0.2.2:8001 expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild && node ../../scripts/pin-android-gradle-jdk.mjs",
    "archive:ios": "bash scripts/archive-ios-testflight.sh",
    "lint": "tsc --noEmit",
    "test:maestro": "maestro test maestro/",
    "test:maestro:p0": "maestro test maestro/ --include-tags=p0"
  },
  "dependencies": {
    "@clerk/expo": "^4.6.6",
    "@porterchain/mobile-theme": "file:./vendor/mobile-theme",
    "@porterchain/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.14",
    "typescript": "~6.0.3"
  }
}
