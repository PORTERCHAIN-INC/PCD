{
  "expo": {
    "name": "Porterchain Driver",
    "slug": "porterchain-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "porterchain-driver",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.porterchain.driver",
      "associatedDomains": [
        "applinks:porterchain.com",
        "applinks:www.porterchain.com",
        "applinks:driver.porterchain.com"
      ]
    },
    "android": {
      "package": "com.porterchain.driver",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "porterchain.com",
              "pathPrefix": "/auth/driver-invite"
            },
            {
              "scheme": "https",
              "host": "www.porterchain.com",
              "pathPrefix": "/auth/driver-invite"
            },
            {
              "scheme": "https",
              "host": "driver.porterchain.com",
              "pathPrefix": "/auth/driver-invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
