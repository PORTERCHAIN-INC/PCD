# =============================================================================
# PORTERCHAIN API — FastAPI (port 8001 recommended)
# Copy to: apps/api/.env
# =============================================================================

# --- REQUIRED — core ---------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=debug
PORTERCHAIN_API_URL=http://localhost:8001

# --- REQUIRED — Clerk JWT verification ---------------------------------------

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# --- REQUIRED — website booking OTP bridge -----------------------------------

PORTERCHAIN_WEBSITE_OTP_KEY=

# --- REQUIRED — Fleetbase bridge ---------------------------------------------

FLEETBASE_API_URL=http://localhost:8000
PORTERCHAIN_FLEETBASE_DEFAULT_COMPANY_UUID=
PORTERCHAIN_FLEETBASE_DISPATCH_BRIDGE=true
PORTERCHAIN_FLEETBASE_DRIVER_JOB_BRIDGE=true
PORTERCHAIN_DISPATCHER_API_KEY=change-me-dispatcher-key

# --- PRODUCTION — assignment gate --------------------------------------------

PORTERCHAIN_FLEETBASE_ASSIGNMENT_REQUIRED=false

# --- REQUIRED — booking OTP --------------------------------------------------

BOOKING_OTP_SKIP_VERIFY=false
BOOKING_OTP_DEV_FALLBACK=false

# Supabase (OTP for personal / phone SMS path)
# NEXT_PUBLIC_* vars live on website; API uses server config as needed

# Booking OTP email (business) — Zoho SMTP
BOOKING_OTP_SMTP_HOST=smtp.zohocloud.ca
BOOKING_OTP_SMTP_PORT=465
BOOKING_OTP_SMTP_USER=
BOOKING_OTP_SMTP_PASS=
BOOKING_OTP_FROM_EMAIL=ops@porterchain.com
BOOKING_OTP_FROM_NAME=Porterchain
SUPABASE_EMAIL_PROBE_ADDRESS=

# --- REQUIRED — Twilio SMS (personal booking OTP) ------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- REQUIRED — Stripe (server only — never in website .env) -----------------

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Merchant invoice checkout redirects
PORTERCHAIN_STRIPE_SUCCESS_URL=http://localhost:3001/invoices?paid=1
PORTERCHAIN_STRIPE_CANCEL_URL=http://localhost:3001/invoices?cancelled=1

# Retail pay-after-delivery (website tracking page)
PORTERCHAIN_RETAIL_PAY_URL_BASE=http://localhost:3000/track
PORTERCHAIN_RETAIL_STRIPE_SUCCESS_URL=http://localhost:3000/track/{tracking_number}?paid=1
PORTERCHAIN_RETAIL_STRIPE_CANCEL_URL=http://localhost:3000/track/{tracking_number}?cancelled=1

# --- REQUIRED — Google Maps (server / IP-restricted keys) --------------------

GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_LOCALE=us

# --- REQUIRED — routing (server-side) ----------------------------------------

ROUTING_ENGINE=valhalla
OSRM_HOST=https://router.project-osrm.org
VALHALLA_BASE_URL=http://localhost:8002

# --- REQUIRED — notifications ------------------------------------------------

PORTERCHAIN_FROM_EMAIL=ops@porterchain.com
PORTERCHAIN_FROM_NAME=Porterchain
PORTERCHAIN_TRACKING_URL=http://localhost:3000/track/
PORTERCHAIN_OPS_EMAILS=ops@porterchain.com

# Platform SMTP (invoices, ops mail)
MAIL_MAILER=smtp
MAIL_HOST=smtp.zohocloud.ca
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=ops@porterchain.com
MAIL_FROM_NAME=Porterchain

# --- REQUIRED — driver onboarding (invite emails) ------------------------------

DRIVER_PORTAL_BASE_URL=http://localhost:3003
DRIVER_APP_DOWNLOAD_URL=
DRIVER_APP_IOS_URL=
DRIVER_APP_ANDROID_URL=
DRIVER_INVITE_TOKEN_EXPIRE_SECONDS=604800
AUTH_DRIVER_INVITE_VALIDATE_MAX_ATTEMPTS_PER_MINUTE=30
AUTH_DRIVER_INVITE_ACCEPT_MAX_ATTEMPTS_PER_MINUTE=15

# --- OPTIONAL — Firebase FCM (driver push from API) --------------------------

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/fleetbase/api/storage/app/firebase/service-account.json
PORTERCHAIN_DRIVER_PUSH_ENABLED=false
PORTERCHAIN_DRIVER_PUSH_SEND=false

# --- OPTIONAL — database (if API uses PostgreSQL) ------------------------------

# DATABASE_URL=postgresql://porterchain:password@localhost:5432/porterchain_api

# --- OPTIONAL — Redis (rate limits, cache) -----------------------------------

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- OPTIONAL — infrastructure -----------------------------------------------

# DIGITALOCEAN_API_TOKEN=
# SENTRY_DSN=
