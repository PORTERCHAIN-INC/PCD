# =============================================================================
# PORTERCHAIN API — FastAPI (port 8001 recommended)
# Copy to: apps/api/.env
# =============================================================================

# --- REQUIRED — core ---------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=debug
PORTERCHAIN_API_URL=http://localhost:8001

# --- REQUIRED — Keycloak JWT verification ---------------------------------------

IDP_PUBLISHABLE_KEY=
IDP_SECRET_KEY=
IDP_JWKS_URL=

# Portal URLs — Keycloak invitation redirect targets
ADMIN_PORTAL_URL=http://localhost:3002
MERCHANT_PORTAL_URL=http://localhost:3001
DRIVER_PORTAL_URL=http://localhost:3003
WEBSITE_URL=http://localhost:3000

DISPATCH_ENGINE=porterchain

# --- PRODUCTION — assignment gate --------------------------------------------


# --- REQUIRED — Stripe (server only — never in website .env) -----------------

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# DRIVER_IDENTITY_VERIFICATION_ENABLED=true
# DRIVER_IDENTITY_RETURN_URL=http://localhost:3003/profile?identity=return
# DRIVER_BACKGROUND_CHECK_ENABLED=true
# CHECKR_API_KEY=
# CHECKR_WEBHOOK_SECRET=
# CHECKR_PACKAGE_SLUG=driver_pro
# CHECKR_MOCK=true
# DRIVER_ABSTRACT_VERIFICATION_ENABLED=true
# DRIVER_ABSTRACT_MAX_DEMERITS=8
# DRIVER_COMPLIANCE_EXPIRY_SWEEP_ENABLED=true

# Merchant invoice checkout redirects
PORTERCHAIN_STRIPE_SUCCESS_URL=http://localhost:3001/invoices?paid=1
PORTERCHAIN_STRIPE_CANCEL_URL=http://localhost:3001/invoices?cancelled=1

# Retail pay-after-delivery (website tracking page)
PORTERCHAIN_RETAIL_PAY_URL_BASE=http://localhost:3000/track
PORTERCHAIN_RETAIL_STRIPE_SUCCESS_URL=http://localhost:3000/track/{tracking_number}?paid=1
PORTERCHAIN_RETAIL_STRIPE_CANCEL_URL=http://localhost:3000/track/{tracking_number}?cancelled=1

# --- REQUIRED — Google Maps (server / IP-restricted keys) --------------------


# --- REQUIRED — routing (server-side) ----------------------------------------

ROUTING_ENGINE=valhalla
OSRM_HOST=http://localhost:5000
VALHALLA_BASE_URL=http://localhost:8002

# --- REQUIRED — notifications ------------------------------------------------

PORTERCHAIN_TRACKING_URL=http://localhost:3000/track/
PORTERCHAIN_OPS_EMAILS=ops@porterchain.com

# Platform SMTP — see docs/notifications/ZOHO_MAIL.md
# Local: Mailpit localhost:1025. Prod: smtp.zohocloud.ca:465 SSL (Zoho Canada).
# Aliases: peter@, ravi@, billing@, no-reply@, ops@, sales@, support@ porterchain.com
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=ops@porterchain.com
MAIL_FROM_ADDRESS2=sales@porterchain.com
MAIL_FROM_ADDRESS3=ravi@porterchain.com
MAIL_FROM_NAME=Porterchain (local)

# --- REQUIRED — driver onboarding (invite emails) ------------------------------

DRIVER_PORTAL_BASE_URL=http://localhost:3003
# Store gate (GET /health/status → mobile.driver)
# DRIVER_APP_MIN_VERSION=1.0.0
# DRIVER_APP_FORCE_UPDATE=false
# DRIVER_APP_STORE_URL_IOS=https://apps.apple.com/app/porterchain-driver
# DRIVER_APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.porterchain.PCD
# DRIVER_APP_UPDATE_MESSAGE=A required update is available for the Porterchain Driver app.

# --- OPTIONAL — Firebase FCM (driver push from API) --------------------------

FIREBASE_PROJECT_ID=
# Local: copy service account JSON to apps/api/.secrets/firebase-service-account.json (gitignored)
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json
# Production (droplet): use FIREBASE_CREDENTIALS_JSON in GitHub Actions secrets instead of a file path
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIREBASE_WEB_VAPID_KEY=
PORTERCHAIN_PUSH_ENABLED=false
PORTERCHAIN_PUSH_SEND=false
PORTAL_RATE_LIMIT_PER_MINUTE=120
PORTERCHAIN_DRIVER_PUSH_ENABLED=false
PORTERCHAIN_DRIVER_PUSH_SEND=false

# --- FEATURE_AI (doc 60 R2) — off; no LLM client or AI keys in Phase 0 ---------
# FEATURE_AI=false


# ============================================================================
# OPTIONAL — every remaining setting not shown above, with its code default.
# Rebuilt from apps/api config.py + shared PlatformSettings (2026-10-29).
# Secret values: set them in secrets/droplet.enc.yaml (SOPS), never here.
# ============================================================================

# --- Identity (Keycloak) -------------------------------------------------------
# L36: Keycloak is the only auth provider (no dual mode).
# AUTH_PROVIDER=keycloak
# KEYCLOAK_URL=
# KEYCLOAK_INTERNAL_URL=
# KEYCLOAK_REALM=porterchain
# KEYCLOAK_ISSUER=
# KEYCLOAK_AUDIENCE=pc-api
# KEYCLOAK_ALLOWED_CLIENTS=
# Confidential service-account client (realm-management manage-users) used to provision staff accounts. Secret comes from SOPS (KEYCLOAK_ADMIN_CLIENT_SE
# KEYCLOAK_ADMIN_CLIENT_ID=pc-api-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# AUTH_DEV_BYPASS=false
# SSO_JWT_SECRET=  (alias: PORTERCHAIN_SSO_JWT_SECRET)
# JWT_SECRET=
# IDP_DEV_BYPASS=false
# JWT_ACCESS_TTL_MINUTES=60
# JWT_REFRESH_TTL_DAYS=30

# --- Interac e-Transfer (merchant payments) ------------------------------------
# Interac e-Transfer inbox reader (billing@ on Zoho Mail). Off by default; env only — the app password is never stored in the database or settings UI.
# INTERAC_IMAP_ENABLED=false
# INTERAC_IMAP_HOST=imappro.zoho.com
# INTERAC_IMAP_PORT=993
# INTERAC_IMAP_USER=
# INTERAC_IMAP_PASSWORD=
# INTERAC_IMAP_FOLDER=INBOX
# INTERAC_IMAP_LOOKBACK_DAYS=60
# authserv-id of OUR receiving server's Authentication-Results header (Zoho: mx.zohomail.com). Only that header is trusted; a sender can forge others.
# INTERAC_AUTHSERV_ID=mx.zohomail.com
# BILLING_CYCLE_AUTORUN_ENABLED=false

# --- Email (SMTP / ZeptoMail / Zoho) -------------------------------------------
# ZEPTOMAIL_WEBHOOK_SECRET=
# mailto half of List-Unsubscribe on marketing/CRM email (must be a monitored inbox).
# UNSUBSCRIBE_MAILBOX=unsubscribe@porterchain.com
# Extra recipients (comma separated) for security alerts; active super admins always get them.
# SECURITY_ALERT_EMAIL=
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=465
# Zoho mailbox login (e.g. sales@porterchain.com) — shared by SMTP + IMAP.
# ZOHO_MAIL_USER=
# Zoho *app-specific* password (never the account password). Secret store only.
# ZOHO_MAIL_APP_PASSWORD=
# ZOHO_IMAP_HOST=imap.zoho.com
# ZOHO_IMAP_FOLDER=INBOX
# ZEPTOMAIL_API_URL=https://api.zeptomail.ca/v1.1/email

# --- Lead desk -----------------------------------------------------------------
# JSON map territory key → admin_user id, e.g. {"ON":"...","GTA":"...","default":"..."}.
# LEAD_TERRITORY_MAP_JSON=
# JSON list of admin_user ids for round-robin when territory misses, e.g. ["id1","id2"].
# LEAD_ROUND_ROBIN_JSON=
# When true, Meta/Google/social webhooks enqueue to Redis WEBHOOKS (async ingest).
# LEAD_INGEST_ASYNC=false
# JSON map channel → first-response SLA minutes, e.g. {"whatsapp":15,"default":60}.
# LEAD_SLA_MINUTES_JSON=
# Lead agent auto-send (welcome email / WhatsApp auto-reply / nurture steps). OFF by default since 2026-10: replies are drafted instantly and wait for a
# LEAD_AGENT_AUTO_SEND=false
# Lead desk — owner alert email for new high-priority leads ("" = assignee only).
# LEAD_ALERT_EMAIL=
# Optional LLM polish for drafts / score notes. No LLM ships in Phase 0 (FEATURE_AI off); rules always apply.
# LEAD_AI_ENABLED=false
# Unified lead inbox — WhatsApp Cloud replies/inbound are OFF until this is true (and META_WA_ACCESS_TOKEN + META_WA_PHONE_NUMBER_ID are set).
# WHATSAPP_CLOUD_ENABLED=false
# Lead reply email: "" (disabled) | "zeptomail" (HTTPS API, SMTP_PASSWORD token) | "zoho_smtp" (Zoho Mail SMTP with an app password).
# LEAD_REPLY_EMAIL_TRANSPORT=
# LEAD_REPLY_FROM=sales@porterchain.com
# LEAD_REPLY_FROM_NAME=PorterChain Sales
# Inbound email → lead threads by polling the Zoho mailbox over IMAP (worker).
# LEAD_INBOUND_IMAP_ENABLED=false
# HMAC secret for POST /v1/public/mail/inbound (forwarder / parse webhook).
# LEAD_INBOUND_EMAIL_SECRET=
# Unknown senders writing to sales@ create a new lead (else: only thread to existing).
# LEAD_INBOUND_EMAIL_CREATE_LEADS=true

# --- Shopify -------------------------------------------------------------------
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# client_id:secret:shop.myshopify.com, comma-separated (custom-distribution apps).
# SHOPIFY_EXTRA_APPS=
# SHOPIFY_API_SCOPES=
# 2026-10: carrierServiceCreate no longer auto-attaches to the General profile (merchant adds the rate in Shipping and delivery); see shopify_one_click 
# SHOPIFY_API_VERSION=2026-10
# Request read_returns (returns/approve + returns/cancel via GraphQL webhooks). Turn on only after an app version with that scope is released in the Par
# SHOPIFY_RETURNS_SCOPE_ENABLED=false
# SHOPIFY_CARRIER_RATE_LIMIT_PER_MINUTE=120
# SHOPIFY_WEBHOOK_RATE_LIMIT_PER_MINUTE=300
# When true, register Shopify FulfillmentService + FO request webhooks on install. Default off — orders/create + mid-flight tracking remain the live pat
# SHOPIFY_FULFILLMENT_SERVICE_ENABLED=false
# G21 reviewer accounts (doc 74 §3). Off by default; emails only, never passwords here.
# REVIEWER_ACCOUNTS_ENABLED=false
# REVIEWER_DRIVER_EMAILS=
# 4-click embedded onboarding (confirm pickup → Go live). Phase 0 G20: the default path. Set SHOPIFY_FOUR_CLICK_ONBOARDING_ENABLED=false to fall back to
# SHOPIFY_FOUR_CLICK_ONBOARDING_ENABLED=true

# --- Phase 2 feature flags (all off by default) --------------------------------
# PORTERCHAIN_PHASE2_CRM=false
# RETIRED — Route Center tables/code removed; keep flag for env compat (always treat as off).
# PORTERCHAIN_PHASE2_ROUTE_CENTER=false
# PORTERCHAIN_PHASE2_AI_DISPATCH=false
# PORTERCHAIN_PHASE2_ANALYTICS=false
# PORTERCHAIN_PHASE2_INTELLIGENCE=false
# PORTERCHAIN_OAUTH_THIRD_PARTY_ENABLED=true

# --- Push / notifications / SMS (no SMS vendor) --------------------------------
# NOTIFICATION_MAX_RETRIES=5
# PORTERCHAIN_SMS_ENABLED=false
# PORTERCHAIN_SMS_PROVIDER=
# Comma-separated. When set, staff email (including push fallback) goes only to these addresses.
# OPS_WATCH_EMAILS=

# --- Driver app ----------------------------------------------------------------
# DRIVER_ABSTRACT_ALLOWED_CLASSES=G,A,B,C,D,E,F
# Deprecated driver_location_pings INSERT. Default off — last-known Redis is the registry.
# GPS_WRITE_PING_TABLE=false
# ENABLE_DRIVER_AUTO_REOPTIMIZE=true

# --- Checkout / pricing --------------------------------------------------------
# L33/doc 72: issued quotes are honoured for 72 h (was 30 min). Env QUOTE_TTL_MINUTES overrides.
# QUOTE_TTL_MINUTES=4320
# BOOKING_DRAFT_TTL_MINUTES=1440
# STRIPE_MOCK=true
# RETAIL_CHECKOUT_SUCCESS_URL=http://localhost:3000/en/book/success
# RETAIL_CHECKOUT_CANCEL_URL=http://localhost:3000/en/book/continue
# CUSTOMER_CHECKOUT_SUCCESS_URL=
# CUSTOMER_CHECKOUT_CANCEL_URL=
# Server pricing: max drift allowed vs client website estimate (2% or $1 CAD).
# PRICING_CLIENT_TOLERANCE_CENTS=100
# PRICING_CLIENT_TOLERANCE_PERCENT=0.02

# --- Error tracking (GlitchTip) ------------------------------------------------
# Self-hosted GlitchTip DSN (doc 36). Empty = error tracking off.
# GLITCHTIP_DSN=

# --- Rate limits / API ---------------------------------------------------------
# Interactive /docs, /redoc and /openapi.json. Always on in local/dev/test; off in staging/production unless API_DOCS_ENABLED=true (readiness audit 2026
# API_DOCS_ENABLED=false
# ADMIN_APP_URL=http://localhost:3002
# PUBLIC_RATE_LIMIT_PER_MINUTE=120

# --- Other ---------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://porterchain:porterchain@localhost:5432/porterchain
# DATABASE_URL_REPLICA=
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=3
# DB_POOL_RECYCLE=1800
# CORS_ORIGINS=
# SpiceDB (Zanzibar) — access-rules graph (not business data) Default off until compose SpiceDB is up; set SPICEDB_ENABLED=true locally.
# SPICEDB_ENABLED=false
# SPICEDB_REQUIRED=false
# SPICEDB_ENDPOINT=localhost:50051
# SPICEDB_PRESHARED_KEY=
# SPICEDB_USE_MEMORY=false
# CUSTOMER_PORTAL_URL=http://localhost:3004
# WEBSITE_REVALIDATE_SECRET=
# BLOG_MEDIA_PUBLIC_BASE_URL=
# BLOG_MEDIA_S3_ENDPOINT=
# BLOG_MEDIA_S3_BUCKET=
# BLOG_MEDIA_S3_ACCESS_KEY_ID=
# BLOG_MEDIA_S3_SECRET_ACCESS_KEY=
# BLOG_MEDIA_S3_REGION=auto
# BLOG_MEDIA_S3_PREFIX=blog-media
# PUBLIC_INGEST_API_KEY=
# Meta Lead Ads / Instagram / Facebook / WhatsApp Cloud webhooks (Graph).
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# Shared secret for Google Ads lead form / GBP message ingest (X-Lead-Webhook-Secret).
# GOOGLE_LEAD_WEBHOOK_SECRET=
# Shared secret for LinkedIn / X / YouTube lead webhooks (X-Lead-Webhook-Secret).
# SOCIAL_LEAD_WEBHOOK_SECRET=
# Meta Conversions API (CRM offline) — Lead ID attributed events.
# META_CAPI_ACCESS_TOKEN=
# META_PIXEL_ID=  (alias: NEXT_PUBLIC_META_PIXEL_ID)
# LINKEDIN_CAPI_TOKEN=
# urn:lla:llaPartnerConversion:{id} for LinkedIn Conversions API.
# LINKEDIN_CONVERSION_URN=
# Meta WhatsApp Cloud — System User token (whatsapp_business_messaging).
# META_WA_ACCESS_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_BUSINESS_ACCOUNT_ID=
# Optional JSON map PCD template key → Meta template name.
# META_WA_TEMPLATE_MAP_JSON=
# Referral credit (cents) granted when a referred lead converts to merchant.
# REFERRAL_CREDIT_CENTS=25000
# CHECKR_API_BASE_URL=https://api.checkr.com
# Parcel label signing key (PC1 codes). Empty = derived from JWT_SECRET (domain-separated).
# LABEL_SIGNING_SECRET=
# Redis — cache, events, queues
# REDIS_URL=redis://localhost:6379/0
# OSRM_ALLOW_PUBLIC_DEMO=false
# auto | smtp | https — auto uses HTTPS for ZeptoMail in non-local envs (DO blocks SMTP).
# MAIL_TRANSPORT=auto

# --- Self-hosted geo (doc 60 R4) (read directly from the environment) -------------
# PHOTON_URL=  # Photon base URL (compose: http://photon:2322). Empty = Nominatim only.

# Capped Google Places (New) backup when Photon is not confident (server key only; free tier).
# GOOGLE_MAPS_SERVER_API_KEY=   # from SOPS droplet secrets; IP-restricted; never ship to browsers
# GEO_GOOGLE_FALLBACK=true      # set false/0 to disable backup
# GEO_GOOGLE_DAILY_CAP=300      # billable autocomplete+details calls/day; fails closed without Redis
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search  # Fallback geocoder.
# NEXT_PUBLIC_MAP_TILES_URL=https://tiles.porterchain.com  # Self-hosted PMTiles host (web portals).

# --- Workers / ops (read directly from the environment) ---------------------------
# WORKER_MODE=  # Worker role selector.
# WORKER_CONSUMER_NAME=worker-1
# WORKER_PAUSED_SWEEPS=  # Comma-separated sweep names to pause.
# MERCHANT_OPS_SWEEP_ENABLED=true
# DRIVER_DUTY_REQUIRED_FOR_COMPLETION=true
# PICKUP_DOCUMENT_GATE=off

# --- Security / network (read directly from the environment) ----------------------
# TRUSTED_PROXY_HOPS=1
# TRUSTED_SERVER_IPS=
# ADMIN_IP_ALLOWLIST_BREAK_GLASS=  # Break-glass admin IP list.
# AUDIT_SIGNING_KEY=  # Secret: SOPS only.
# PRINCIPAL_CACHE_TTL_SECONDS=30
# CLAMD_HOST=  # ClamAV for uploads.
# CLAMD_PORT=3310

# --- Media / storage (read directly from the environment) -------------------------
# POD_MEDIA_DIR=  # Proof-of-delivery media directory.
# BLOG_MEDIA_DIR=
# BLOG_MEDIA_PUBLIC_BASE_URL=
# BLOG_MEDIA_S3_ENDPOINT=  # S3-compatible (self-hosted Garage).
# BLOG_MEDIA_S3_BUCKET=
# BLOG_MEDIA_S3_PREFIX=
# BLOG_MEDIA_S3_REGION=
# BLOG_MEDIA_S3_ACCESS_KEY_ID=  # Secret: SOPS only.
# BLOG_MEDIA_S3_SECRET_ACCESS_KEY=  # Secret: SOPS only.

# --- Observability / version (read directly from the environment) -----------------
# OTEL_EXPORTER_OTLP_ENDPOINT=
# PORTERCHAIN_VERSION=3.1.0
