# Porterchain API local development
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=debug
PORTERCHAIN_API_URL=http://localhost:8001
DATABASE_URL=sqlite:///./porterchain.db
QUOTE_TTL_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clerk — set for production; bypass in local mock booking
CLERK_DEV_BYPASS=true
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Stripe — mock checkout until keys configured
STRIPE_MOCK=true
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

RETAIL_CHECKOUT_SUCCESS_URL=http://localhost:3000/en/book/success
RETAIL_CHECKOUT_CANCEL_URL=http://localhost:3000/en/book/continue

FLEETBASE_API_URL=http://localhost:8000
FLEETBASE_DISPATCH_BRIDGE=false
FLEETBASE_DEFAULT_COMPANY_UUID=
