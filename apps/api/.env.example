# Porterchain API local development
# Full template: env/api.env.example (canonical — copy that file instead)
#   cp env/api.env.example apps/api/.env
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=debug
PORTERCHAIN_API_URL=http://localhost:8001
DATABASE_URL=postgresql+psycopg://porterchain:porterchain@localhost:5432/porterchain
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
QUOTE_TTL_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clerk — legacy single-app local dev, or per-class keys in production (see env/api.env.example)
CLERK_DEV_BYPASS=true
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# CLERK_CUSTOMER_SECRET_KEY=
# CLERK_MERCHANT_SECRET_KEY=
# CLERK_ADMIN_SECRET_KEY=
# CLERK_DRIVER_SECRET_KEY=

# Stripe — mock checkout until keys configured
STRIPE_MOCK=true
STRIPE_SECRET=
# Local CLI: `pnpm stripe:listen` → copy printed whsec_… here (restart API after change)
STRIPE_WEBHOOK_SECRET=
# Alternate listener session (elegant-wonder-thin): swap into STRIPE_WEBHOOK_SECRET if needed

RETAIL_CHECKOUT_SUCCESS_URL=http://localhost:3000/en/book/success
RETAIL_CHECKOUT_CANCEL_URL=http://localhost:3000/en/book/continue
# Customer portal Stripe return (defaults to CUSTOMER_PORTAL_URL/book/success when unset)
CUSTOMER_CHECKOUT_SUCCESS_URL=http://localhost:3004/book/success
CUSTOMER_CHECKOUT_CANCEL_URL=http://localhost:3004/book

# Phase 2 — all default false until Phase 1 loop boring (ADR-014)
PORTERCHAIN_PHASE2_CRM=false
PORTERCHAIN_PHASE2_ROUTE_CENTER=false
PORTERCHAIN_PHASE2_AI_DISPATCH=false
PORTERCHAIN_PHASE2_ANALYTICS=false
PORTERCHAIN_PHASE2_INTELLIGENCE=false
PORTERCHAIN_OAUTH_THIRD_PARTY_ENABLED=true

FLEETBASE_API_URL=http://localhost:8000
FLEETBASE_API_KEY=
FLEETBASE_DEFAULT_COMPANY_UUID=
FLEETBASE_DISPATCH_BRIDGE=false
FLEETBASE_WEBHOOK_SECRET=
