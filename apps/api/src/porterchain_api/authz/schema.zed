/** PorterChain access-rules schema (SpiceDB / Zanzibar).
 *
 * PostgreSQL holds business rows. SpiceDB holds who may touch them.
 * Admin roles are platform relations (AdminRole.value) — not a single staff blob.
 * Module permissions expand from MODULE_PERMISSIONS (admin_engine/rbac.py).
 */

definition user {}

definition platform {
    relation super_admin: user
    relation admin: user
    relation dispatcher: user
    relation support: user
    relation support_lead: user
    relation sales: user
    relation sales_manager: user
    relation finance: user
    relation compliance: user
    relation developer: user
    relation marketing: user
    relation read_only: user
    relation fleet_manager: user

    // Portal entry — any provisioned staff role (must not reuse relation name ``admin``)
    permission portal = super_admin + admin + dispatcher + support + support_lead + sales + sales_manager + finance + compliance + developer + marketing + read_only + fleet_manager
    // God-mode unified permission — super_admin only
    permission system_all = super_admin

    permission dashboard = super_admin + admin + dispatcher + support + support_lead + sales + sales_manager + finance + compliance + developer + marketing + read_only + fleet_manager
    permission crm = super_admin + admin + sales + sales_manager + marketing
    permission crm_read = super_admin + admin + sales + sales_manager + support + support_lead + marketing
    permission quotes = super_admin + admin + dispatcher + sales + fleet_manager
    permission quotes_read = super_admin + admin + dispatcher + support + support_lead + sales + finance + read_only
    permission bookings = super_admin + admin + dispatcher + support + support_lead
    permission merchants = super_admin + admin + sales + sales_manager + compliance
    permission merchants_read = super_admin + admin + dispatcher + support + sales + sales_manager + finance + compliance + read_only
    permission drivers = super_admin + admin + dispatcher + fleet_manager + compliance
    permission drivers_read = super_admin + admin + dispatcher + support + sales + compliance + fleet_manager + read_only
    permission customers = super_admin + admin + support + support_lead + compliance
    permission customers_read = super_admin + admin + dispatcher + support + support_lead + sales + sales_manager + finance + compliance + read_only
    permission dispatch = super_admin + admin + dispatcher + fleet_manager
    permission dispatch_read = super_admin + admin + dispatcher + support + support_lead
    permission orders = super_admin + admin + dispatcher + support + support_lead
    permission orders_read = super_admin + admin + dispatcher + support + support_lead + sales + finance + compliance + read_only
    // mod_* — SpiceDB forbids permission names that match a relation on the same definition
    permission mod_finance = super_admin + admin + finance + support_lead
    permission finance_read = super_admin + admin + finance + support + support_lead
    permission claims = super_admin + admin + support_lead + finance + compliance
    permission claims_read = super_admin + admin + dispatcher + support + support_lead
    permission mod_support = super_admin + admin + dispatcher + support + support_lead
    permission support_read = super_admin + admin + dispatcher + support + support_lead + sales + finance + read_only
    permission reports = super_admin + admin + dispatcher + support + support_lead + sales + sales_manager + finance + compliance + developer + marketing + read_only + fleet_manager
    permission settings = super_admin + admin
    permission notifications = super_admin + admin + dispatcher + support_lead + marketing
    permission notifications_read = super_admin + admin + dispatcher + support + support_lead + sales + sales_manager + finance + compliance + developer + marketing + read_only + fleet_manager
    permission developers = super_admin + admin + developer
    permission diagnostics = super_admin + admin + developer
    permission diagnostics_write = super_admin + admin
    permission map = super_admin + admin + dispatcher + fleet_manager + support
    permission routes = super_admin + admin + dispatcher + fleet_manager
    permission routes_read = super_admin + admin + dispatcher + fleet_manager + support + support_lead + read_only
    permission routes_dispatch = super_admin + admin + dispatcher
    permission content = super_admin + admin + marketing
    permission content_read = super_admin + admin + marketing + sales + read_only
}

definition organization {
    // Maps 1:1 to MerchantRole (merchant_owner → owner, …). Legacy ``member`` kept for revoke cleanup.
    relation owner: user
    relation admin: user
    relation ops: user
    relation finance: user
    relation readonly: user
    relation member: user

    permission portal = owner + admin + ops + finance + readonly + member
    permission manage = owner + admin
    permission dashboard = owner + admin + ops + finance + readonly + member
    permission book = owner + admin + ops
    permission bulk = owner + admin + ops
    permission api_keys = owner + admin
    permission orders = owner + admin + ops + finance + readonly + member
    permission orders_write = owner + admin + ops
    permission tracking = owner + admin + ops + finance + readonly + member
    permission invoices = owner + admin + ops + finance + readonly + member
    permission invoices_pay = owner + admin + finance
    permission statements = owner + admin + finance + readonly
    permission reports = owner + admin + ops + finance + readonly + member
    permission billing = owner + admin + finance
    permission users = owner + admin
    permission settings = owner + admin + finance + ops
    permission support = owner + admin + ops + finance + readonly + member
    permission claims = owner + admin + ops + finance
}

definition driver_profile {
    relation owner: user
    permission access = owner
}

definition customer_profile {
    relation owner: user
    permission access = owner
}

definition order {
    relation parent: organization
    relation viewer: user

    permission view = viewer + parent->orders
    permission manage = parent->orders_write
}
