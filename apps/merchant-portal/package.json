{
  "name": "@porterchain/merchant-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "next dev --port 3001 --webpack",
    "build": "next build",
    "start": "next start --port 3001",
    "test:e2e": "playwright test",
    "test:e2e:p0": "playwright test --grep @p0",
    "test:e2e:live": "playwright test e2e/book.golden.p0.spec.ts --grep 'MP-BOOK-001|MP-AUTH-006'",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:codegen:dispatcher": "mkdir -p e2e/.auth && playwright codegen http://127.0.0.1:3001/sign-in --save-storage=e2e/.auth/dispatcher.json",
    "test:e2e:codegen:viewer": "mkdir -p e2e/.auth && playwright codegen http://127.0.0.1:3001/sign-in --save-storage=e2e/.auth/viewer.json",
    "lint": "eslint",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.14",
    "@porterchain/auth": "workspace:*",
    "@porterchain/maps": "workspace:*",
    "@porterchain/types": "workspace:*",
    "@porterchain/ui": "workspace:*",
    "@sentry/nextjs": "^10.64.0",
    "@tanstack/react-query": "^5.101.2",
    "@vis.gl/react-google-maps": "^1.9.0",
    "date-fns": "^4.4.0",
    "firebase": "12.19.0",
    "lucide-react": "^1.23.0",
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@porterchain/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.6.0",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
