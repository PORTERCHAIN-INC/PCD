# =============================================================================
# MERCHANT PORTAL — Next.js B2B dashboard (port 3001)
# Copy to: apps/merchant-portal/.env.local
# =============================================================================

# --- REQUIRED — Keycloak auth ---------------------------------------------------

NEXT_PUBLIC_IDP_PUBLISHABLE_KEY=
IDP_SECRET_KEY=

# --- REQUIRED — API ----------------------------------------------------------

NEXT_PUBLIC_PORTERCHAIN_API_URL=http://localhost:8001
PORTERCHAIN_API_URL=http://localhost:8001

# --- REQUIRED — Stripe checkout --------------------------------------------

PORTERCHAIN_STRIPE_SUCCESS_URL=http://localhost:3001/invoices?paid=1
PORTERCHAIN_STRIPE_CANCEL_URL=http://localhost:3001/invoices?cancelled=1

# --- OPTIONAL — site URL -----------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- OPTIONAL — monitoring ---------------------------------------------------

# NEXT_PUBLIC_GLITCHTIP_DSN=   # self-hosted GlitchTip public DSN; empty = off
