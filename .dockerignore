# Keep Docker build contexts small and reproducible.
**/node_modules
**/.venv
**/.next
**/.turbo
**/__pycache__
**/*.pyc
**/*.pyo
.git
.git/**
.github
*.db
**/*.db
.pnpm-store
**/.DS_Store
**/.env
**/.env.*
!**/.env.example
# Never bake local Clerk test keys into production images (next.config loads env/clerk.env).
env/clerk.env
env/clerk.env.*
!env/clerk.env.example
terminals

# Mac beta copy: local-stack secrets/screenshots live inside the repo dir here; never send to builds
.pcd-local-stack
.pcd-local-stack/**
